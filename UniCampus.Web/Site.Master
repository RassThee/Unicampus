
<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.master.cs"
    Inherits="UniCampus.Web.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">

    <meta http-equiv="Content-Type"
          content="text/html; charset=utf-8" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> - UniCampus</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference
        runat="server"
        path="~/Content/css" />

    <link href="~/favicon.ico"
          rel="shortcut icon"
          type="image/x-icon" />

    <style>
        body {
            background-color: #f3f5f9;
            font-family: Arial, sans-serif;
            color: #253047;
        }

        /* BARRA PRINCIPAL */
        .navbar-unicampus {
            background-color: #203864 !important;
            padding: 14px 0;
            box-shadow: 0 3px 10px rgba(0,0,0,0.12);
        }

        .navbar-unicampus .navbar-brand {
            color: #ffffff !important;
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .navbar-unicampus .nav-link {
            color: #e2e8f0 !important;
            font-size: 15px;
            font-weight: 500;
            padding: 10px 14px !important;
            border-radius: 6px;
            transition: background-color 0.2s ease;
        }

        .navbar-unicampus .nav-link:hover {
            background-color: #35568d;
            color: #ffffff !important;
        }

        .navbar-unicampus .navbar-toggler {
            border-color: rgba(255,255,255,0.5);
        }

        .contenido-unicampus {
            min-height: 70vh;
            padding-top: 25px;
        }

        /* PIE DE PAGINA */
        .footer-unicampus {
            text-align: center;
            padding: 25px 10px;
            color: #64748b;
            font-size: 14px;
            border-top: 1px solid #e2e8f0;
            margin-top: 35px;
        }

        .footer-unicampus p {
            margin: 5px 0;
        }

        @media (max-width: 576px) {
            .navbar-unicampus .nav-link {
                padding: 12px !important;
            }

            .contenido-unicampus {
                padding-top: 15px;
            }
        }
    </style>

</head>

<body>

    <form runat="server">

        <!-- COMPONENTES DE ASP.NET WEB FORMS -->
        <asp:ScriptManager runat="server">
            <Scripts>

                <asp:ScriptReference Name="MsAjaxBundle" />

                <asp:ScriptReference Name="jquery" />

                <asp:ScriptReference
                    Name="WebForms.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebForms.js" />

                <asp:ScriptReference
                    Name="WebUIValidation.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebUIValidation.js" />

                <asp:ScriptReference
                    Name="MenuStandards.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/MenuStandards.js" />

                <asp:ScriptReference
                    Name="GridView.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/GridView.js" />

                <asp:ScriptReference
                    Name="DetailsView.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/DetailsView.js" />

                <asp:ScriptReference
                    Name="TreeView.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/TreeView.js" />

                <asp:ScriptReference
                    Name="WebParts.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebParts.js" />

                <asp:ScriptReference
                    Name="Focus.js"
                    Assembly="System.Web"
                    Path="~/Scripts/WebForms/Focus.js" />

                <asp:ScriptReference Name="WebFormsBundle" />

            </Scripts>
        </asp:ScriptManager>

        <!-- MENU DE NAVEGACION -->
        <nav class="navbar navbar-expand-sm navbar-dark navbar-unicampus">

            <div class="container">

                <a class="navbar-brand"
                   runat="server"
                   href="~/Default.aspx">
                    UniCampus
                </a>

                <button
                    type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuUniCampus"
                    aria-controls="menuUniCampus"
                    aria-expanded="false"
                    aria-label="Mostrar navegación">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="menuUniCampus">

                    <ul class="navbar-nav ms-auto">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link"
                               runat="server"
                               href="~/Default.aspx">
                                Inicio
                            </a>
                        </li>

                        <!-- ACTIVIDADES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               runat="server"
                               href="~/Actividades.aspx">
                                Actividades
                            </a>
                        </li>

                        <!-- INSCRIPCIONES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               runat="server"
                               href="~/Inscripciones.aspx">
                                Inscripciones
                            </a>
                        </li>

                        <!-- RESENAS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               runat="server"
                               href="~/Resenas.aspx">
                                Reseñas
                            </a>
                        </li>

                        <!-- ESTADISTICAS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               runat="server"
                               href="~/Estadisticas.aspx">
                                Estadísticas
                            </a>
                        </li>

                        <!-- ESTUDIANTES: SOLO DOCENTES -->
                        <% if (Context.User.Identity.IsAuthenticated &&
                               Convert.ToString(Session["RolUsuario"]) == "Organizador") { %>

                            <li class="nav-item">
                                <a class="nav-link"
                                   runat="server"
                                   href="~/Estudiantes.aspx">
                                    Estudiantes
                                </a>
                            </li>

                        <% } %>

                    </ul>

                </div>

            </div>

        </nav>

        <!-- CONTENIDO DE CADA PAGINA -->
        <div class="container contenido-unicampus">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

            <!-- PIE DE PAGINA -->
            <footer class="footer-unicampus">

                <p>
                    &copy; <%: DateTime.Now.Year %>
                    UniCampus - Sistema de Gestión Académica
                </p>

                <p>
                    Aplicación desarrollada con ASP.NET Web Forms,
                    C# y SQL Server.
                </p>

            </footer>

        </div>

    </form>

    <!-- SCRIPT DE BOOTSTRAP -->
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

</body>
</html>
